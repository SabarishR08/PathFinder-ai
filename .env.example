# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (Supabase pooler — required for Vercel deployment)
# Append ?pgbouncer=true when using Supabase's pooler (port 6543)
DATABASE_URL="postgresql://user:pass@host:5432/postgres"

# ─── LLM providers (any one configured is enough; multi-provider chain falls back) ──

# Vercel AI Gateway (recommended) — one key, usage dashboard, automatic failover
# Get key at https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=groq/llama-3.3-70b-versatile
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Direct Groq (fallback when no gateway key) — free at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Together, NVIDIA NIM, Ollama…)
OPENAI_API_KEY=
OPENAI_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── Evidence ingestion ──────────────────────────────────────────────────────
# GitHub: unauthenticated requests get 60/hour. A token raises to 5,000/hour
# and lifts the README fetch limit. Optional but strongly recommended.
GITHUB_TOKEN=

# ─── Optional security ──────────────────────────────────────────────────────
# Restrict CORS to a known origin (comma-separated).
# ALLOWED_ORIGINS=https://your-frontend.example.com
