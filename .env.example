# ─── Database ────────────────────────────────────────────────────────────────
# SQLite default (file-based; works out of the box). Swap for Postgres on deploy:
#   DATABASE_URL=postgresql://user:pass@host:5432/pathfinder
DATABASE_URL="file:./db/custom.db"

# ─── LLM providers (any one configured is enough; multi-provider chain falls back) ──
# Groq — free at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Together, NVIDIA NIM, Ollama…)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── Evidence ingestion ──────────────────────────────────────────────────────
# GitHub: unauthenticated requests get 60/hour. A token raises to 5,000/hour
# and lifts the README fetch limit. Optional but strongly recommended.
GITHUB_TOKEN=

# ─── Optional security ──────────────────────────────────────────────────────
# Restrict CORS to a known origin (comma-separated).
# ALLOWED_ORIGINS=https://your-frontend.example.com
